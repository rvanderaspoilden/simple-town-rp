# Copy to .env and fill in the values, then `docker compose --env-file .env up -d`.
#
# ⚠️ IMPORTANT — every literal `$` in a value MUST be doubled to `$$`. Docker
#    Compose interpolates `$VAR` and `${VAR}` references in this file, so an
#    unescaped `$` in a bcrypt hash will be eaten as a (missing) variable name
#    and the value will arrive broken in the containers. Real-world example:
#       wrong : SEQ_BASIC_AUTH_HASH=$2a$14$abcdef...
#       right : SEQ_BASIC_AUTH_HASH=$$2a$$14$$abcdef...

# Domain that Caddy will serve Seq on. Leave SEQ_HOST blank to disable the
# HTTPS block (you'll only have plain :80, useful when there's no DNS yet).
SEQ_HOST=seq.your-domain.tld

# bcrypt hash of the basicauth password for Caddy. Generate with:
#   docker run --rm caddy caddy hash-password --plaintext "your_password"
# Then double every $ when you paste below.
SEQ_BASIC_AUTH_HASH=$$2a$$14$$REPLACE_ME_WITH_REAL_HASH

# Seq admin password hash. Generate with:
#   docker run --rm -it datalust/seq config hash
# Then double every $ when you paste below.
SEQ_ADMIN_PASSWORD_HASH=$$SEQ$$1$$REPLACE_ME_WITH_REAL_SEQ_HASH

      npcText: "Burgers, hot-dogs, tacos, brochettes\u2026 tout est fait minute,
        \xE0 emporter !"
      options:
      - text: Je commande.
        action: 2
        nextNodeId: 
      - text: Une prochaine fois.
        action: 1
        nextNodeId: 

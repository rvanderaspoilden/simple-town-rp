  dialogue:
    rootNodeId: root
    nodes:
    - id: root
      npcText: "Bienvenue \xE0 mon \xE9tal ! Je suis {name}. Que puis-je pour toi
        ?"
      options:
      - text: Montre-moi tes articles.
        action: 2
        nextNodeId:
      - text: Qu'est-ce que tu vends ?
        action: 0
        nextNodeId: wares

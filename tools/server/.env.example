# Copy to .env and fill in the values, then `docker compose --env-file .env up -d`.

# Domain that Caddy will serve Seq on. Leave SEQ_HOST blank to disable the
# HTTPS block (you'll only have plain :80, useful when there's no DNS yet).
SEQ_HOST=seq.your-domain.tld

# bcrypt hash of the basicauth password for the Seq UI. Generate with:
#   docker run --rm -it caddy caddy hash-password
SEQ_BASIC_AUTH_HASH=$2a$14$REPLACE_ME_WITH_REAL_HASH

# Seq admin password hash. Generate with:
#   docker run --rm -it datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=REPLACE_ME_WITH_REAL_SEQ_HASH
